# EventGenie AI Configuration
# OpenRouter API Key (Supports OpenAI, Anthropic Claude, Meta LLaMA 3.3, Google Gemini, Mistral)
OPENROUTER_API_KEY=

# Optional: Preferred model (Default: openai/gpt-4o-mini)
# Popular choices:
# - openai/gpt-4o-mini
# - anthropic/claude-3.5-sonnet
# - meta-llama/llama-3.3-70b-instruct
# - google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Google Gemini API Key
GEMINI_API_KEY=
